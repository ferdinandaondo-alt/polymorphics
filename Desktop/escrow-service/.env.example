# Copy this file to ".env" and fill in every value. NEVER commit ".env" to git.

# Your domain (DNS A record must point at this server) for automatic HTTPS.
# Use "localhost" to try it on your own computer.
SITE_ADDRESS=escrow.example.com

# Database password. Generate:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Secret used to sign login tokens. Must be 32+ random characters. Generate:  openssl rand -hex 32
# If this leaks, anyone can forge logins - treat it like a master key.
JWT_SECRET=change-me-to-a-long-random-string

# Optional: platform fee in basis points (250 = 2.5%) and the amount above which KYC is required
# (in minor units: 100000 = 1,000.00).
PLATFORM_FEE_BPS=250
KYC_THRESHOLD=100000
